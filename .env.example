# Salin jadi .env lalu sesuaikan. .env tidak ikut ke git.

# true  = frontend jalan sendiri pakai data fixture (backend belum perlu)
# false = frontend memanggil API asli di /api
VITE_USE_FIXTURES=true

# Port backend diatur di vite.config.ts (API_PROXY_TARGET), bukan di sini,
# karena hanya dipakai dev server saat proxy /api.
